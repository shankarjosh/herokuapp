<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HerokuApp Cross-Device Suite" parallel="tests" thread-count="3">

    <!-- 1. Windows Chrome -->
    <test name="Chrome on Windows">
        <parameter name="browser" value="chrome"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="os" value="Windows"/>
        <parameter name="osVersion" value="11"/>
        <classes>
            <class name="hirokotest.HerokuAppSeleniumTests"/>
        </classes>
    </test>



    <!-- 3. OnePlus 12R (Real Android Device via BrowserStack) -->
    <test name="Chrome on OnePlus 12R">
        <parameter name="browser" value="chrome"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="os" value="android"/>
        <parameter name="osVersion" value="14"/>
        <parameter name="deviceName" value="OnePlus 12R"/>
        <classes>
            <class name="hirokotest.HerokuAppSeleniumTests"/>
        </classes>
    </test>

</suite>